{
  "name": "project-major-utc2-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "UTC2 Thesis Management System - Monorepo",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "pnpm -r build",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:studio": "pnpm --filter backend prisma:studio",
    "prisma:seed": "pnpm --filter backend prisma:seed",
    "prisma:deploy": "pnpm --filter backend prisma:deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
