# ==============================================================================
# UTC2 THESIS MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database (PostgreSQL) - Kết nối tới Global PostgreSQL container (E:\DevTools)
DATABASE_URL="postgresql://postgres:root_password@localhost:5432/utc2_thesis_db?schema=public"
# Nếu chạy Backend trong Docker cùng mạng global-dev-net:
# DATABASE_URL="postgresql://postgres:root_password@global_postgres:5432/utc2_thesis_db?schema=public"

# Redis Cache & BullMQ Queue - Kết nối tới Global Redis container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Nếu trong Docker: REDIS_HOST=global_redis

# MinIO / S3 Object Storage - Kết nối tới Global MinIO container
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET_NAME=utc2-thesis-files
MINIO_USE_SSL=false

# RabbitMQ (Optional Background Event Bus)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Security & Authentication (JWT)
JWT_ACCESS_SECRET="utc2_thesis_jwt_access_secret_super_key_2026_!@#"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="utc2_thesis_jwt_refresh_secret_super_key_2026_!@#"
JWT_REFRESH_EXPIRES_IN="7d"

# Mail SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@utc2.edu.vn
SMTP_PASS=app_password_here
SMTP_FROM="UTC2 Thesis System <no-reply@utc2.edu.vn>"
